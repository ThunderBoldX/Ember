<Window x:Class="Ember.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ember" Title="Ember" Width="1280" Height="910" MinWidth="1060" MinHeight="760" Background="#070707" WindowStartupLocation="CenterScreen" WindowStyle="None" FontFamily="Inter, Segoe UI" Foreground="White">
 <Window.Resources><Style x:Key="IconTile" TargetType="Border"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="CornerRadius" Value="11"/><Setter Property="BorderBrush" Value="#22FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#1C1816"/></Style></Window.Resources>
 <Grid>
  <Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
   <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Background="#080808" MouseLeftButtonDown="DragTitle">
    <Grid Margin="24,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="BrandIcon" Width="40" Height="40" Margin="0,0,12,0"/><TextBlock Text="EMBER" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Click="MinimizeClick" Padding="13,10" Background="Transparent" BorderBrush="Transparent" ToolTip="Згорнути"><Path Data="M 0,5 L 10,5" Width="10" Height="10" Stroke="#BBBBBB" StrokeThickness="1.2"/></Button>
      <Button Click="MaximizeClick" Padding="13,10" Background="Transparent" BorderBrush="Transparent" ToolTip="Розгорнути"><Path Data="M 1,1 L 9,1 L 9,9 L 1,9 Z" Width="10" Height="10" Stroke="#BBBBBB" StrokeThickness="1.2"/></Button>
      <Button Click="CloseClick" Padding="13,10" Background="Transparent" BorderBrush="Transparent" ToolTip="Закрити"><Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Width="10" Height="10" Stroke="#BBBBBB" StrokeThickness="1.2"/></Button>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1" ClipToBounds="True" IsHitTestVisible="False"><local:Atmosphere/></Grid>
   <ScrollViewer x:Name="MainScroll" Grid.Row="1" ClipToBounds="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <Grid Margin="32,24,32,24" MinWidth="940"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6"><Button x:Name="ScanButton" Content="Пошук Bluetooth" Click="ScanClick" Margin="0,0,10,0"/><Button x:Name="ConnectButton" Content="Підключити  →" Style="{StaticResource Primary}" Click="ConnectClick"/></StackPanel>
     </Grid>
     <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="0" BorderBrush="#66FF5A1F"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Height="1" Background="{StaticResource Ember}" VerticalAlignment="Top" Margin="18,0"/>
       <Grid Margin="22,20,22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ТВОЯ СТРІЧКА" Style="{StaticResource Label}"/><TextBlock x:Name="DeviceTitle" Text="Очікує підключення" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DeviceSubtitle" Text="Увімкни живлення стрічки та Bluetooth. Пошук показує всі пристрої, навіть без назви." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,15,0"/></StackPanel>
        <Border Grid.Column="1" Style="{StaticResource IconTile}" ToolTip="Bluetooth"><Grid><Border Height="1" Background="#88FF5A1F" VerticalAlignment="Top" Margin="10,0"/><Path Data="M 9,2 L 17,8 L 3,20 M 9,2 L 9,26 L 17,20 L 3,8" Stroke="{StaticResource Ember}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
       </Grid>
       <StackPanel Grid.Row="1" Margin="22,18,22,22"><ComboBox x:Name="Devices" DisplayMemberPath="DisplayName" SelectionChanged="DeviceSelectionChanged"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox Visibility="Collapsed" x:Name="Profiles" SelectionChanged="ProfileChanged"><ComboBoxItem Content="ELK-BLEDOB"/><ComboBoxItem Content="MELK"/><ComboBoxItem Content="ELK-BLEDDM"/><ComboBoxItem Content="Triones"/></ComboBox><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ForgetDevice" Content="Забути" Click="ForgetDeviceClick"/><Button x:Name="DisconnectButton" Content="Від'єднати" Margin="12,0,0,0" Click="DisconnectClick" IsEnabled="False"/></StackPanel></Grid></StackPanel>
      </Grid></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="СВІТЛО" Style="{StaticResource Label}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PowerButton" Content="ON" Tag="on" Padding="9,5" Click="PowerClick" IsEnabled="False"/><Button x:Name="PowerOffButton" Content="OFF" Tag="off" Margin="6,0,0,0" Padding="9,5" Click="PowerClick" IsEnabled="False"/></StackPanel></Grid><Grid Margin="0,10,0,0"><StackPanel><TextBlock Text="ЯСКРАВІСТЬ" FontSize="10" Foreground="#888888"/><TextBlock x:Name="BrightnessText" Text="70%" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><local:RingMeter x:Name="BrightnessRing" Width="74" Height="74" HorizontalAlignment="Right" Value="0.7"/></Grid><Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="70" ValueChanged="BrightnessChanged"/><Grid Margin="0,8,0,0"><TextBlock Text="ШВИДКІСТЬ ЕФЕКТУ" FontSize="10" Foreground="#888888"/><TextBlock x:Name="SpeedText" Text="50%" HorizontalAlignment="Right" Foreground="#FF5A1F" FontSize="10"/></Grid><Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" Value="50" ValueChanged="SpeedChanged"/></StackPanel></Border>
     </Grid>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="АУДІОАНАЛІЗ" Style="{StaticResource Label}" Margin="0"/><TextBlock x:Name="AudioState" Text="  /  НЕАКТИВНИЙ" Foreground="#737373" FontSize="10"/></StackPanel><TextBlock x:Name="SampleRateText" Text="— kHz · FFT 1024" HorizontalAlignment="Right" Foreground="#737373" FontSize="10"/></Grid>
      <Grid Grid.Row="1" Margin="0,18,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><local:SpectrumView x:Name="Spectrum" Height="110"/><Grid Margin="0,8,0,0"><TextBlock Text="30 Hz" FontSize="9" Foreground="#666666"/><TextBlock Text="18 kHz" FontSize="9" Foreground="#666666" HorizontalAlignment="Right"/></Grid></StackPanel><StackPanel Grid.Column="2"><local:HistoryView x:Name="History" Height="110"/><Grid Margin="0,8,0,0"><TextBlock Text="ЕНЕРГІЯ СИГНАЛУ · 12 с" FontSize="9" Foreground="#666666"/><TextBlock x:Name="BeatText" Text="Очікує сигналу" FontSize="9" Foreground="#FF5A1F" HorizontalAlignment="Right"/></Grid></StackPanel></Grid>
      <UniformGrid Grid.Row="2" Columns="7" Margin="0,15,0,0"><StackPanel><TextBlock Text="ТЕМП ≈" Style="{StaticResource Label}"/><TextBlock x:Name="BpmText" Text="—" FontSize="26" FontWeight="SemiBold" Foreground="#FF5A1F"/></StackPanel><StackPanel><TextBlock Text="RMS · dBFS" Style="{StaticResource Label}"/><TextBlock x:Name="RmsText" Text="—" FontSize="26" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="ПІК · dBFS" Style="{StaticResource Label}"/><TextBlock x:Name="PeakText" Text="—" FontSize="26" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="БАС · %" Style="{StaticResource Label}"/><TextBlock x:Name="BassText" Text="—" FontSize="26" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock x:Name="EventLabel" Text="БІТИ" Style="{StaticResource Label}"/><TextBlock x:Name="BeatsText" Text="0" FontSize="26" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="ВІДГУК · мс¹" Style="{StaticResource Label}"/><TextBlock x:Name="LatencyText" Text="—" FontSize="26" FontWeight="SemiBold"/></StackPanel><StackPanel><TextBlock Text="КОМАНДИ¹" Style="{StaticResource Label}"/><TextBlock x:Name="CommandsText" Text="0" FontSize="26" FontWeight="SemiBold"/></StackPanel></UniformGrid>
     </Grid></Border>
     <Grid Grid.Row="3" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Border x:Name="EffectsCard" Style="{StaticResource Card}" Padding="22,18" VerticalAlignment="Top"><StackPanel>
       <Grid><TextBlock Text="ЕФЕКТИ" Style="{StaticResource Label}"/><TextBlock x:Name="EffectState" Text="НЕ ПІДКЛЮЧЕНО" HorizontalAlignment="Right" Foreground="#FF5A1F" FontSize="9"/></Grid>
       <WrapPanel Margin="0,3,0,16"><RadioButton x:Name="HardwareTab" Content="Автономні" GroupName="Effects" Style="{StaticResource EffectTab}" IsChecked="True" Checked="HardwareTabClick"/><RadioButton x:Name="MusicTab" Content="Музика з ПК" GroupName="Effects" Style="{StaticResource EffectTab}" Checked="MusicTabClick"/><RadioButton x:Name="MicTab" Content="Звук стрічки" GroupName="Effects" Style="{StaticResource EffectTab}" Checked="MicTabClick"/><RadioButton x:Name="CustomTab" Content="Мої ефекти" GroupName="Effects" Style="{StaticResource EffectTab}" Checked="CustomTabClick"/><RadioButton x:Name="ImportedTab" Content="Імпортовані" GroupName="Effects" Style="{StaticResource EffectTab}" Checked="ImportedTabClick"/></WrapPanel>
       <WrapPanel Margin="0,0,0,12"><Button Content="↓ Імпорт" Click="ImportEffectClick" Padding="12,7" Margin="0,0,8,0"/><Button x:Name="ExportEffect" Content="↑ Експорт" Click="ExportEffectClick" Padding="12,7" Margin="0,0,8,0"/><Button x:Name="ExportCategory" Content="Експорт категорії" Click="ExportCategoryClick" Padding="12,7"/></WrapPanel>
       <UniformGrid x:Name="EffectGrid" Columns="4"/>
       <StackPanel x:Name="StripMicPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock Text="ЧУТЛИВІСТЬ МІКРОФОНА СТРІЧКИ" Style="{StaticResource Label}"/><Slider x:Name="StripMicSlider" Minimum="0" Maximum="100" Value="35"/><Button x:Name="StripMicApply" Content="Застосувати чутливість" Click="StripMicApplyClick" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
       <StackPanel x:Name="CustomPanel" Visibility="Collapsed">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="SavedEffects" DisplayMemberPath="Name" SelectionChanged="SavedEffectChanged"/><Button Grid.Column="1" Content="+ Створити" Click="NewEffectClick" Margin="10,0,0,0" Padding="12,8"/></Grid>
        <WrapPanel Margin="0,12,0,12"><Button x:Name="PlayCustom" Content="▶ Відтворити" Click="PlayCustomClick" Style="{StaticResource Primary}" Margin="0,0,8,8"/><Button x:Name="PauseCustom" Content="Пауза" Click="PauseCustomClick" Margin="0,0,8,8"/><Button x:Name="StopCustom" Content="Стоп" Click="StopCustomClick" Margin="0,0,8,8"/><Button x:Name="EditCustom" Content="Редагувати" Click="EditCustomClick" Margin="0,0,8,8"/><Button x:Name="NextCustom" Content="Подати сигнал «Далі»" Click="NextCustomClick" Margin="0,0,8,8"/><Button x:Name="DeleteCustom" Content="Видалити" Click="DeleteCustomClick" Margin="0,0,0,8"/></WrapPanel>
        <Border Background="#141414" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel><TextBlock x:Name="SequenceState" Text="Створи ефект із власних кольорів і таймінгів." Foreground="#AAAAAA" FontSize="12"/><WrapPanel x:Name="SequenceColors" Margin="0,12,0,0"/></StackPanel></Border>
       </StackPanel>
       <TextBlock TextWrapping="Wrap" x:Name="EffectHelp" Text="16 автономних ефектів для твоєї стрічки." Foreground="#888888" FontSize="11" Margin="0,13,0,0"/>
       <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="FallbackCheck" Content="Після виходу відновлювати автономний ефект" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/><Button Grid.Column="1" x:Name="ApplyRelease" Content="Застосувати й від'єднати ↗" Padding="12,8" Click="ApplyReleaseClick" IsEnabled="False" Margin="12,0,0,0"/></Grid>
      </StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18" VerticalAlignment="Top"><StackPanel><TextBlock Text="КОЛІР СТРІЧКИ" Style="{StaticResource Label}"/><local:ColorPicker x:Name="StripPalette"/><Button x:Name="ApplyColorButton" Content="Застосувати колір →" Click="ColorClick" Margin="0,13,0,0"/>
       <Border Background="#15FFFFFF" Height="1" Margin="0,18,0,16"/><TextBlock Text="ЧУТЛИВІСТЬ ДО ЗВУКУ" Style="{StaticResource Label}"/><Slider x:Name="SensitivitySlider" Minimum="0" Maximum="100" Value="55" ValueChanged="SensitivityChanged"/>
       <TextBlock Text="МУЗИКА З ПК" Style="{StaticResource Label}" Margin="0,8,0,0"/><Button x:Name="AudioButton" Content="Увімкнути аналіз" Click="AudioClick" Margin="0,10,0,0"/>
       <TextBlock x:Name="AudioSourceHelp" Text="Аналізує звук, який відтворює Windows." FontSize="10" Foreground="#737373" Margin="0,10,0,0"/>
      </StackPanel></Border>
     </Grid>
     <Border Grid.Row="4" Style="{StaticResource Card}" Padding="20,15"><Expander x:Name="Diagnostics" Header="Діагностика та налаштування ефектів" Foreground="#AAAAAA" FontSize="12"><StackPanel Margin="0,16,0,0"><TextBlock Text="Номери залежать від контролера. Вибери режим за ID, перевір ефект і збережи відповідність." FontSize="11" Foreground="#888888"/>
      <Grid Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="JUMP3 → ID" Style="{StaticResource Label}"/><TextBox x:Name="Jump3Id"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="JUMP7 → ID" Style="{StaticResource Label}"/><TextBox x:Name="Jump7Id"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="FADE3 → ID" Style="{StaticResource Label}"/><TextBox x:Name="Fade3Id"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="FADE7 → ID" Style="{StaticResource Label}"/><TextBox x:Name="Fade7Id"/></StackPanel><Button Grid.Column="4" Content="Зберегти ID" Click="SaveMappingClick" VerticalAlignment="Bottom"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AllModes"/><Button Grid.Column="2" Content="Застосувати режим" Click="RawModeClick"/><TextBox Grid.Column="4" x:Name="ManualAddress" Width="170" ToolTip="MAC стрічки, наприклад BE:32:00:00:00:00."/></Grid>
      <CheckBox x:Name="TrayCheck" Content="Ховати у трей замість згортання" Margin="0,16,0,12" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/><TextBlock x:Name="DiagnosticText" FontFamily="Consolas" FontSize="10" Foreground="#888888"/><TextBlock Text="¹ Команди й час запису на боці Windows. RSSI оновлюється під час пошуку." FontSize="10" Foreground="#737373" Margin="0,12,0,8"/><TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10"/>
     </StackPanel></Expander></Border>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="2" Background="#0C0C0D" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0"><Grid Margin="24,0"><TextBlock x:Name="Status" Text="Готово · Увімкни Bluetooth і знайди стрічку." VerticalAlignment="Center" FontSize="11" Foreground="#999999"/><TextBlock Text="EMBER 0.5.3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="#666666"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
